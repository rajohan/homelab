# Nonsecret reference only. Inject secrets privately through scoped Doppler access.
# Empty placeholders intentionally prevent production startup.
# See docs/identity-operations.md. Do not copy production values into this file.
HOMELAB_AUTH_HOST=127.0.0.1
HOMELAB_AUTH_PORT=3101
HOMELAB_AUTH_ISSUER=https://auth.example.test
HOMELAB_AUTH_DASHBOARD_ORIGIN=https://dashboard.example.test
HOMELAB_AUTH_RP_ID=example.test
HOMELAB_AUTH_DATABASE_URL=
HOMELAB_AUTH_ENCRYPTION_KEY=
HOMELAB_AUTH_COOKIE_KEY=
HOMELAB_AUTH_PROXY_KEY=
HOMELAB_AUTH_JWKS=
HOMELAB_AUTH_CLIENTS=
HOMELAB_AUTH_DASHBOARD_CLIENT_ID=homelab-dashboard
HOMELAB_AUTH_POLICY_FILE=/etc/homelab-auth/access-policy.yml
HOMELAB_AUTH_RESEND_API_KEY=
HOMELAB_AUTH_EMAIL_FROM='Homelab <home@example.test>'
# Development relaxation is accepted only when NODE_ENV is not production.
HOMELAB_AUTH_DEVELOPMENT=false
# Lifetimes in seconds. Changes take effect after restarting auth.
HOMELAB_AUTH_SESSION_MAX_AGE_SECONDS=43200
HOMELAB_AUTH_SESSION_IDLE_TIMEOUT_SECONDS=3600
HOMELAB_AUTH_STEP_UP_MAX_AGE_SECONDS=300
HOMELAB_AUTH_REMEMBER_MAX_AGE_SECONDS=2592000
HOMELAB_AUTH_REMEMBER_IDLE_TIMEOUT_SECONDS=604800

HOMELAB_DASHBOARD_HOST=127.0.0.1
HOMELAB_DASHBOARD_PORT=3100
HOMELAB_DASHBOARD_AUTH_ISSUER=https://auth.example.test
HOMELAB_DASHBOARD_ORIGIN=https://dashboard.example.test
HOMELAB_DASHBOARD_OIDC_CLIENT_ID=homelab-dashboard
HOMELAB_DASHBOARD_OIDC_CLIENT_SECRET=
# Must match this client in HOMELAB_AUTH_CLIENTS.
HOMELAB_DASHBOARD_OIDC_AUTH_METHOD=client_secret_post
HOMELAB_DASHBOARD_SESSION_KEY=
HOMELAB_DASHBOARD_AUTH_DEVELOPMENT=false
