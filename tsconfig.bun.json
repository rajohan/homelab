{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "lib": ["ESNext"],
        "types": ["bun"],
        "jsx": "react-jsx"
    },
    "include": [
        "apps/**/*.ts",
        "apps/**/*.tsx",
        "packages/**/*.ts",
        "packages/**/*.tsx",
        "scripts/**/*.ts",
        "tests/**/*.ts",
        "*.config.ts"
    ],
    "exclude": [
        "**/node_modules",
        "**/dist",
        "**/*.test.tsx",
        "tests/dom.ts",
        "apps/dashboard/src/app.tsx",
        "apps/dashboard/src/main.tsx",
        "apps/dashboard/src/client.ts",
        "apps/dashboard/src/browser/**",
        "apps/auth/src/browser/**",
        "packages/ui/src/**",
        "packages/identity-ui/src/**"
    ]
}
