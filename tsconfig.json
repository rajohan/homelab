{
    "compilerOptions": {
        "target": "ESNext",
        "module": "Preserve",
        "moduleResolution": "Bundler",
        "moduleDetection": "force",
        "allowImportingTsExtensions": true,
        "verbatimModuleSyntax": true,
        "resolveJsonModule": true,
        "noEmit": true,
        "strict": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noImplicitAny": true,
        "noImplicitReturns": true,
        "noUncheckedIndexedAccess": true,
        "noUncheckedSideEffectImports": true,
        "exactOptionalPropertyTypes": true,
        "noFallthroughCasesInSwitch": true,
        "noImplicitOverride": true,
        "erasableSyntaxOnly": true,
        "paths": {
            "@homelab/mira/data/*": ["./apps/mira/src/server/data/*.ts"],
            "@homelab/mira/operations/*": ["./apps/mira/src/server/operations/*.ts"],
            "@homelab/mira/files/*": ["./apps/mira/src/server/files/*.ts"],
            "@homelab/mira/runtime/*": ["./apps/mira/src/server/runtime/*.ts"],
            "@homelab/mira/integrations/*": ["./apps/mira/src/server/integrations/*.ts"],
            "@homelab/mira/improvement/*": ["./apps/mira/src/server/improvement/*.ts"],
            "@homelab/mira/sandbox/*": ["./apps/mira/src/server/sandbox/*.ts"],
            "@homelab/mira/skills/*": ["./apps/mira/src/server/skills/*.ts"],
            "@homelab/contracts": ["./packages/contracts/src/index.ts"],
            "@homelab/contracts/files": ["./packages/contracts/src/files.ts"],
            "@homelab/contracts/operations": ["./packages/contracts/src/operations.ts"],
            "@homelab/contracts/notifications": [
                "./packages/contracts/src/notifications.ts"
            ],
            "@homelab/contracts/applications": [
                "./packages/contracts/src/applications.ts"
            ],
            "@homelab/contracts/logs": ["./packages/contracts/src/logs.ts"],
            "@homelab/contracts/alerts": ["./packages/contracts/src/alerts.ts"],
            "@homelab/contracts/backups": ["./packages/contracts/src/backups.ts"],
            "@homelab/contracts/updates": ["./packages/contracts/src/updates.ts"],
            "@homelab/contracts/tableSort": ["./packages/contracts/src/tableSort.ts"],
            "@homelab/contracts/infrastructure": [
                "./packages/contracts/src/infrastructure.ts"
            ],
            "@homelab/contracts/maintenance": ["./packages/contracts/src/maintenance.ts"],
            "@homelab/contracts/mira": ["./packages/contracts/src/mira.ts"],
            "@homelab/contracts/miraOperations": [
