{
    "name": "homelab",
    "version": "0.9.0",
    "private": true,
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "type": "module",
    "scripts": {
        "mira:qualify-visual": "bun --no-env-file apps/mira/src/server/cli/qualifyVisual.ts",
        "mira:qualify": "bun --no-env-file apps/mira/src/server/cli/qualify.ts",
        "mira:qualify-product": "bun --no-env-file apps/dashboard/src/server/testing/miraQualification.ts",
        "mira:qualify-container": "bun --no-env-file apps/dashboard/src/server/testing/miraContainerQualification.ts",
        "dev:mira": "bun --no-env-file apps/mira/src/server/index.ts",
        "start:mira": "NODE_ENV=production bun --cwd apps/mira/dist --no-env-file index.js",
        "dev:worker": "bun --no-env-file apps/dashboard/src/worker/worker.ts",
        "start:worker": "NODE_ENV=production bun --cwd apps/dashboard/dist --no-env-file worker.js",
        "dashboard:migrate": "bun --no-env-file apps/dashboard/src/worker/migrate.ts",
        "db:generate:dashboard": "bun node_modules/drizzle-kit/bin.cjs generate --config apps/dashboard/drizzle.config.ts",
        "db:check:dashboard": "bun node_modules/drizzle-kit/bin.cjs check --config apps/dashboard/drizzle.config.ts",
        "setup": "bun scripts/setup.ts",
        "dev": "bun scripts/dev.ts",
        "dev:auth": "bun scripts/dev.ts auth",
        "dev:dashboard": "bun scripts/dev.ts dashboard",
        "start:auth": "NODE_ENV=production bun --cwd apps/auth/dist --no-env-file index.js",
        "start:dashboard": "NODE_ENV=production bun --cwd apps/dashboard/dist --no-env-file index.js",
        "format": "bun node_modules/oxfmt/bin/oxfmt --write .",
        "format:check": "bun node_modules/oxfmt/bin/oxfmt --check .",
        "lint": "bun scripts/lint.ts",
        "typecheck": "bun node_modules/typescript/bin/tsc -p tsconfig.browser.json --noEmit && bun node_modules/typescript/bin/tsc -p tsconfig.bun.json --noEmit && bun node_modules/typescript/bin/tsc -p tsconfig.test.json --noEmit",
        "check": "bun scripts/check.ts",
        "test": "bun scripts/test.ts",
        "test:coverage": "bun scripts/test.ts coverage",
        "test:integration": "bun scripts/test.ts integration",
        "test:smoke": "bun scripts/smoke.ts && bun scripts/smokeIdentity.ts && bun scripts/smokeOperations.ts && bun scripts/smokeMira.ts",
        "test:docker": "bun --no-env-file apps/dashboard/src/server/testing/dockerSmoke.ts && PYTHONDONTWRITEBYTECODE=1 python3 scripts/smokeDockerUpdate.py",
        "test:mira-deployment": "PYTHONDONTWRITEBYTECODE=1 python3 scripts/smokeMiraDeployment.py",
        "build": "bun scripts/build.ts",
        "build:auth": "bun scripts/build.ts auth",
        "build:dashboard": "bun scripts/build.ts dashboard",
        "build:mira": "bun scripts/build.ts mira",
        "test:timings": "bun scripts/test.ts timings",
        "db:generate:auth": "bun node_modules/drizzle-kit/bin.cjs generate --config apps/auth/drizzle.config.ts",
        "db:check:auth": "bun node_modules/drizzle-kit/bin.cjs check --config apps/auth/drizzle.config.ts",
        "auth:admin": "bun apps/auth/src/server/cli/admin.ts",
        "dev:identity": "bun --no-env-file scripts/devIdentity.ts",
        "test:integration:coverage": "bun scripts/test.ts integration-coverage",
        "test:integration:timings": "bun scripts/test.ts integration-timings",
        "test:inventory": "bun scripts/testing/inventory.ts",
        "test:coverage:check": "bun scripts/testing/coverage.ts",
        "test:daytona": "bun --no-env-file apps/mira/src/server/testing/daytonaSmoke.ts",
        "test:computer": "docker build -f deploy/computer-test/Dockerfile -t homelab-computer-test:local . && docker run --rm --init --network none --cap-drop ALL --security-opt no-new-privileges --read-only --tmpfs /tmp:rw,nosuid,nodev,size=128m --tmpfs /home/bun:rw,nosuid,nodev,size=32m,uid=1000,gid=1000 --memory 768m --cpus 2 homelab-computer-test:local",
        "build:computer": "bun --no-env-file scripts/buildComputer.ts",
        "build:computer:windows-host": "bun --no-env-file scripts/buildWindowsConsent.ts",
        "test:computer:windows": "bun --no-env-file scripts/testWindowsConsent.ts",
        "test:computer:windows-acceptance": "bun --no-env-file scripts/testWindowsConsentAcceptance.ts",
        "test:computer:windows-desktop": "bun --no-env-file scripts/testWindowsDesktop.ts",
        "build:computer:windows-worker": "bun --no-env-file scripts/buildWindowsWorker.ts",
        "test:computer:windows-worker": "bun --no-env-file scripts/testWindowsWorker.ts",
        "build:computer:windows": "bun --no-env-file scripts/buildWindowsComputer.ts",
        "test:computer:windows-capture": "bun --no-env-file scripts/testWindowsCapture.ts",
        "test:browser": "docker build -f deploy/browser-test/Dockerfile -t homelab-browser-test:local . && docker run --rm --init --network none --cap-drop ALL --security-opt no-new-privileges --read-only --tmpfs /tmp:rw,nosuid,nodev,size=256m --tmpfs /home/bun:rw,nosuid,nodev,size=128m,uid=1000,gid=1000 --memory 1536m --cpus 2 homelab-browser-test:local"
    },
    "devDependencies": {
        "@happy-dom/global-registrator": "21.0.4",
        "@tailwindcss/typography": "0.5.20",
        "@testing-library/dom": "10.4.2",
        "@testing-library/jest-dom": "7.0.1",
        "@testing-library/react": "16.3.3",
        "@testing-library/user-event": "14.6.8",
        "@types/bun": "1.4.4",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "bun-plugin-tailwind": "0.1.2",
        "drizzle-kit": "1.0.0-rc.5",
        "drizzle-orm": "1.0.0-rc.5",
        "eslint-plugin-jsdoc": "65.4.2",
        "eslint-plugin-react-you-might-not-need-an-effect": "1.0.2",
        "happy-dom": "21.0.4",
        "lcov-result-merger": "6.0.0",
        "lefthook": "2.2.2",
        "oxfmt": "0.74.0",
        "oxlint": "1.89.0",
        "oxlint-config-presets": "0.1.21",
        "oxlint-tailwindcss": "1.16.0",
        "oxlint-tsgolint": "7.0.2005",
        "tailwindcss": "4.3.3",
        "typescript": "7.0.2",
        "valibot": "1.5.0"
    },
    "overrides": {
        "postcss-selector-parser": "7.1.7"
    },
    "engines": {
        "bun": "1.4.4"
    },
    "packageManager": "bun@1.4.4",
    "trustedDependencies": []
}
