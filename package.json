{
    "name": "homelab",
    "version": "0.12.0",
    "private": true,
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "type": "module",
    "scripts": {
        "setup": "bun scripts/setup.ts",
        "dev": "bun scripts/dev.ts",
        "dev:identity": "bun --no-env-file scripts/devIdentity.ts",
        "build": "bun scripts/build.ts",
        "check": "bun scripts/check.ts",
        "format": "bun node_modules/oxfmt/bin/oxfmt --write .",
        "format:check": "bun node_modules/oxfmt/bin/oxfmt --check .",
        "lint": "bun scripts/lint.ts",
        "typecheck": "bun node_modules/typescript/bin/tsc -p tsconfig.browser.json --noEmit && bun node_modules/typescript/bin/tsc -p tsconfig.bun.json --noEmit && bun node_modules/typescript/bin/tsc -p tsconfig.test.json --noEmit",
        "test": "bun scripts/test.ts",
        "test:integration": "bun scripts/test.ts integration",
        "test:smoke": "bun scripts/smoke.ts && bun scripts/smokeIdentity.ts && bun scripts/smokeOperations.ts && bun scripts/smokeMira.ts",
        "db:check:auth": "bun node_modules/drizzle-kit/bin.cjs check --config apps/auth/drizzle.config.ts",
        "db:check:dashboard": "bun node_modules/drizzle-kit/bin.cjs check --config apps/dashboard/drizzle.config.ts",
        "auth:admin": "bun apps/auth/src/server/cli/admin.ts"
    },
    "devDependencies": {
        "@happy-dom/global-registrator": "21.0.4",
        "@tailwindcss/typography": "0.5.20",
        "@testing-library/dom": "10.4.2",
        "@testing-library/jest-dom": "7.0.1",
        "@testing-library/react": "16.3.3",
        "@testing-library/user-event": "14.6.8",
        "@types/bun": "1.4.4",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "bun-plugin-tailwind": "0.1.2",
        "drizzle-kit": "1.0.0-rc.5",
        "drizzle-orm": "1.0.0-rc.5",
        "eslint-plugin-jsdoc": "65.4.2",
        "eslint-plugin-react-you-might-not-need-an-effect": "1.0.2",
        "happy-dom": "21.0.4",
        "lcov-result-merger": "6.0.0",
        "lefthook": "2.2.2",
        "oxfmt": "0.74.0",
        "oxlint": "1.89.0",
        "oxlint-config-presets": "0.1.21",
        "oxlint-tailwindcss": "1.16.0",
        "oxlint-tsgolint": "7.0.2005",
        "tailwindcss": "4.3.3",
        "typescript": "7.0.2",
        "valibot": "1.5.0"
    },
    "overrides": {
        "postcss-selector-parser": "7.1.7"
    },
    "engines": {
        "bun": "1.4.4"
    },
    "packageManager": "bun@1.4.4",
    "trustedDependencies": []
}
