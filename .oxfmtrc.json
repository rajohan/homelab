{
    "printWidth": 90,
    "tabWidth": 4,
    "useTabs": false,
    "semi": true,
    "singleQuote": false,
    "jsxSingleQuote": false,
    "trailingComma": "es5",
    "endOfLine": "lf",
    "ignorePatterns": [
        "**/node_modules/**",
        "**/dist/**",
        "coverage/**",
        "bun.lock",
        "CHANGELOG.md"
    ],
    "overrides": [
        {
            "files": ["*.yaml", "*.yml"],
            "options": {
                "tabWidth": 2
            }
        }
    ]
}
