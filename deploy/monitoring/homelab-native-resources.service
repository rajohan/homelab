[Unit]
Description=Read approved native application resource counters
After=node-exporter.service

[Service]
Type=oneshot
User=node-exporter
CapabilityBoundingSet=
StateDirectory=homelab-native-resources
StateDirectoryMode=0755
ExecStart=/usr/bin/python3 /usr/local/libexec/homelab_native_metrics.py
TimeoutStartSec=8
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
PrivateNetwork=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/homelab-native-resources
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
LockPersonality=true
UMask=0022
