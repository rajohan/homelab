# Rules live only in this proxy container's network namespace.
table inet mira_egress {
    set restricted_v4 {
        type ipv4_addr
        flags interval
        elements = { 0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10, 127.0.0.0/8,
                     169.254.0.0/16, 172.16.0.0/12, 192.0.0.0/24, 192.0.2.0/24,
                     192.88.99.0/24, 192.168.0.0/16, 198.18.0.0/15,
                     198.51.100.0/24, 203.0.113.0/24, 224.0.0.0/4, 240.0.0.0/4 }
    }
    chain input {
        type filter hook input priority 0; policy drop;
        ct state established,related accept
        iifname "browser" tcp dport 3128 accept
    }
    chain forward {
        type filter hook forward priority 0; policy drop;
    }
    chain output {
        # Inspect Docker DNS before its local destination-port translation.
        type filter hook output priority -150; policy drop;
        ct state established,related accept
        ip daddr @restricted_v4 drop
        ip daddr { 1.1.1.1, 9.9.9.9 } tcp dport 53 accept
        meta nfproto ipv4 tcp dport { 80, 443 } accept
        ip daddr { 1.1.1.1, 9.9.9.9 } udp dport 53 accept
    }
}
