# Include in the same host's nginx http context after replacing every placeholder.
# Use one exact private IPv4 listener and explicitly reviewed peer addresses/CIDRs.
# Never include this upstream in a public vhost or enable a public fallback.
geo $realip_remote_addr $homelab_computer_peer {
    default 0;
    @PEER@ 1;
}

server {
    listen @PRIVATE_LISTENER@ ssl bind;
    server_name @HOSTNAME@;
    ssl_certificate @CERTIFICATE@;
    ssl_certificate_key @CERTIFICATE_KEY@;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_tickets off;
    ssl_early_data off;
    access_log off;
    error_log stderr warn;

    # Check the original socket peer even if another vhost enables real-IP rewriting.
    if ($homelab_computer_peer = 0) { return 403; }
    if ($ssl_server_name != @HOSTNAME@) { return 421; }
    if ($host != @HOSTNAME@) { return 421; }

    client_max_body_size 3m;
    client_body_timeout 5s;
    send_timeout 10s;
    keepalive_timeout 15s;

    location ~ ^/api/mira/computers/(enroll|connect|update|heartbeat|access/(pending|accept|stop|permit)|commands/(claim|finish))$ {
        proxy_pass http://127.0.0.1:3113;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection "";
        # Preserve Authorization, Origin and Cookie: the receiver validates/rejects them.
        proxy_pass_request_headers on;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_cache off;
        proxy_next_upstream off;
        proxy_connect_timeout 3s;
        proxy_send_timeout 10s;
        proxy_read_timeout 10s;
    }

    location / { return 404; }
}
