    ],
    "deltas": [
        {
            "op": "alter",
            "key": "checks\u0000[\"public\",\"mira_browser_processes\",\"mira_browser_process_phase\"]",
            "set": {
                "value": "(\"phase\" IN ('reserved','creating','rejected') AND \"container_id\" IS NULL AND (\"phase\"<>'rejected' OR \"state\"<>'active')) OR (\"phase\"='created' AND \"container_id\" IS NOT NULL AND \"container_id\" ~ '^[a-f0-9]{64}$')"
            }
        },
        {
            "op": "alter",
            "key": "checks\u0000[\"public\",\"mira_browser_processes\",\"mira_browser_process_state\"]",
            "set": {
                "value": "(\"state\" IN ('active','cleanup') AND \"removed_at\" IS NULL AND \"cleanup_evidence\" IS NULL) OR (\"state\"='removed' AND \"removed_at\" IS NOT NULL AND \"cleanup_evidence\" IS NOT NULL AND ((\"phase\"='reserved' AND \"cleanup_evidence\"='not-created') OR (\"phase\"='rejected' AND \"cleanup_evidence\"='rejected') OR (\"phase\"='created' AND \"cleanup_evidence\" IN ('removed','absent'))))"
            }
        }
    ]
