        {
            "op": "create",
            "row": {
                "schema": "public",
                "table": "mira_computers",
                "name": "mira_computers_platform",
                "value": "\"platform\" IS NULL OR \"platform\" IN ('win32','linux','darwin')",
                "entityType": "checks"
            }
        },
        {
            "op": "create",
            "row": {
                "schema": "public",
                "table": "mira_computers",
                "name": "mira_computers_credential_state",
                "value": "\n        (\"state\"='pending' AND \"pair_digest\" IS NOT NULL AND \"credential_digest\" IS NULL AND \"paired_at\" IS NULL) OR\n        (\"state\"='paired' AND \"pair_digest\" IS NULL AND \"credential_digest\" IS NOT NULL AND \"paired_at\" IS NOT NULL AND \"installation_id\" IS NOT NULL AND \"platform\" IS NOT NULL AND \"companion_version\" IS NOT NULL) OR\n        (\"state\"='revoked' AND \"pair_digest\" IS NULL AND \"credential_digest\" IS NULL)",
                "entityType": "checks"
            }
        },
        {
            "op": "create",
            "row": {
                "schema": "public",
                "table": "mira_computers",
                "name": "mira_computers_connection",
                "value": "(\"connection_id\" IS NULL AND \"connection_expires_at\" IS NULL) OR (\"state\"='paired' AND \"connection_id\" IS NOT NULL AND \"connection_expires_at\" IS NOT NULL)",
                "entityType": "checks"
            }
        }
