                "value": "(\"state\" IN ('active','cleanup') AND \"removed_at\" IS NULL AND \"cleanup_evidence\" IS NULL) OR (\"state\"='removed' AND \"removed_at\" IS NOT NULL AND \"cleanup_evidence\" IS NOT NULL AND ((\"phase\"='reserved' AND \"cleanup_evidence\"='not-created') OR (\"phase\"='created' AND \"cleanup_evidence\" IN ('removed','absent'))))",
