        {
            "op": "create",
            "row": {
                "schema": "public",
                "table": "mira_browser_consoles",
                "name": "mira_browser_console_state",
                "value": "(\"state\"='idle' AND \"payload\" IS NULL AND \"method\" IS NULL AND \"expires_at\" IS NULL) OR (\"state\" IN ('queued','claimed') AND \"controller\"='human' AND \"command_id\" IS NOT NULL AND \"method\" IN ('observe','navigate','act') AND \"expires_at\" IS NOT NULL AND ((\"state\"='queued' AND \"payload\" IS NOT NULL) OR (\"state\"='claimed' AND \"payload\" IS NULL)))",
                "entityType": "checks"
            }
        },
        {
            "op": "create",
            "row": {
                "schema": "public",
                "table": "mira_browser_consoles",
                "name": "mira_browser_console_size",
                "value": "(\"payload\" IS NULL OR octet_length(\"payload\"::text)<=32768) AND (\"frame\" IS NULL OR octet_length(\"frame\"::text)<=4194304) AND jsonb_typeof(\"attempts\")='array' AND jsonb_array_length(\"attempts\")<=128",
                "entityType": "checks"
            }
        },
